        "profileRef": {
          "additionalProperties": false,
          "properties": {
            "identityDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "profileId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "revision": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "profileId",
            "revision",
            "identityDigest"
          ],
          "type": "object"
        },
        "projectId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "protocol": {
          "const": "execution-outcome/1",
          "type": "string"
        },
        "usage": {
          "additionalProperties": false,
          "properties": {
            "completeness": {
              "enum": [
                "observed",
                "partial",
                "unknown"
              ],
              "type": "string"
            },
            "cost": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "minimum": 0,
                  "type": "number"
                },
                "currency": {
                  "pattern": "^[A-Z]{3}$",
                  "type": "string"
                }
              },
              "required": [
                "currency",
                "amount"
              ],
              "type": "object"
            },
            "evidenceRefs": {
              "items": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string"
              },
              "maxItems": 1024,
              "readOnly": true,
              "type": "array",
              "uniqueItems": true
