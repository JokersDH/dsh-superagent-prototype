        "acceptanceRef": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "artifactDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "attempt": {
          "additionalProperties": false,
          "properties": {
            "assignmentId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "attemptId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "contract": {
