    "ExecutionOutcome": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "enum": [
            "not_requested",
            "accepted",
            "rejected",
            "unknown"
