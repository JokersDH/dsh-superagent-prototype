        },
        "protocol": {
          "const": "route-advice/1",
          "type": "string"
        },
        "reviewSuggested": {
          "type": "boolean"
        },
        "sourceRef": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "suggestedProfileRef": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "identityDigest": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "profileId": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "revision": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "profileId",
                "revision",
                "identityDigest"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "taskContextDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "id",
        "projectId",
        "sourceRef",
        "taskContextDigest",
        "catalogRevision",
        "policyRevision",
        "eligibleProfileRefs",
        "suggestedProfileRef",
        "excluded",
        "basis",
        "evidenceRefs",
        "reviewSuggested",
        "createdAt",
        "expiresAt"
      ],
      "type": "object"
    }
  },
  "$id": "urn:personal-agent:routing-review:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
