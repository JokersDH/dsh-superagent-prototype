            },
            "fenceEpoch": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "ticketId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "ticketId",
            "assignmentId",
            "contract",
            "attemptId",
            "fenceEpoch"
          ],
          "type": "object"
        },
        "candidate": {
          "additionalProperties": false,
          "properties": {
            "assignmentId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "candidateGeneration": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "contract": {
              "additionalProperties": false,
