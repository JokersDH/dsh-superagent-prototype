                "type": "object"
              },
              "messageId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string"
              },
              "projectId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string"
              },
              "selections": {
                "items": {
                  "enum": [
                    "work",
                    "decisions",
                    "project",
                    "conversation",
                    "artifacts"
                  ],
                  "type": "string"
                },
                "maxItems": 5,
                "minItems": 1,
                "readOnly": true,
                "type": "array"
              },
