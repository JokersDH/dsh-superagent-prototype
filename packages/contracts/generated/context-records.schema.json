          "type": "string"
        },
        "protocol": {
          "const": "context-history/1",
          "type": "string"
        },
        "workId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "projectId",
        "observedAt",
        "entries",
        "hasMore"
      ],
      "type": "object"
    },
