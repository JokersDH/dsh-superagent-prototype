{
  "$id": "urn:personal-agent:assistant-context-binding:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundleDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "bundleRef": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "commandId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "confirmedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
    },
    "contract": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "workId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "workId",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "conversationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
    },
    "messageId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "principal": {
      "additionalProperties": false,
      "properties": {
        "authorityRef": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "userId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "userId",
        "authorityRef"
      ],
      "type": "object"
    },
    "projectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "protocol": {
      "const": "assistant-context-binding/1",
      "type": "string"
    },
    "purpose": {
      "const": "conversation_discussion",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "allowedPaths": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "readOnly": true,
          "type": "array"
        },
        "excludedPaths": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "readOnly": true,
          "type": "array"
        },
        "expiresAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        },
        "externalActions": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1024,
          "readOnly": true,
          "type": "array",
          "uniqueItems": true
        },
        "projectId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "allowedPaths",
        "excludedPaths",
        "externalActions"
      ],
      "type": "object",
      "x-runtime-rules": [
        "project-relative-paths"
      ]
    },
    "selections": {
      "items": {
        "enum": [
          "work",
          "decisions",
          "project",
          "conversation",
          "artifacts"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "readOnly": true,
      "type": "array"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "work",
              "contract",
              "verification",
              "delivery",
              "decision",
              "project_metadata",
              "conversation_message",
              "artifact"
            ],
            "type": "string"
          },
          "previewDigest": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "sourceDigest": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "sourceId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "sourceId",
          "kind",
          "sourceDigest",
          "previewDigest",
          "truncated"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "readOnly": true,
      "type": "array"
    },
    "userTextDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "commandId",
    "messageId",
    "requestId",
    "projectId",
    "conversationId",
    "userTextDigest",
    "principal",
    "purpose",
    "scope",
    "selections",
    "bundleRef",
    "bundleDigest",
    "sources",
    "confirmedAt",
    "expiresAt"
  ],
  "type": "object"
}
