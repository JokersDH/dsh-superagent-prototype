            },
            "expectedRevision": {
              "exclusiveMinimum": 0,
              "maximum": 99,
              "type": "integer"
            },
            "kind": {
              "const": "update_project_settings",
              "type": "string"
            },
            "projectId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "commandId",
            "projectId",
            "kind",
            "expectedRevision",
            "displayName",
            "check",
            "environment"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "archived": {
              "type": "boolean"
            },
            "commandId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "expectedArchiveRevision": {
              "maximum": 9007199254740991,
