            "displayName": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            "environment": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "policy": {
                      "const": "existing_only",
                      "type": "string"
                    }
                  },
                  "required": [
                    "policy"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "policy": {
                      "const": "offline_install",
                      "type": "string"
                    },
                    "storeDir": {
                      "maxLength": 4096,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "policy",
                    "storeDir"
                  ],
                  "type": "object"
