{
  "$defs": {
    "WorkCompletionHistory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "const": "none",
          "type": "string"
        },
        "available": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial"
          ],
          "type": "string"
        },
        "currentContract": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "revision": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "workId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "workId",
            "revision",
            "digest"
          ],
          "type": "object"
        },
        "entries": {
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "digest": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "id": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  },
                  "kind": {
                    "const": "contracts",
                    "type": "string"
                  },
                  "revision": {
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "revision",
                  "digest"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "artifactDigest": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "assignmentId": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  },
                  "at": {
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                    "type": "string"
                  },
                  "criteriaDigest": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "generation": {
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "id": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  },
                  "kind": {
                    "const": "verifications",
                    "type": "string"
                  },
                  "ticketId": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "ticketId",
                  "assignmentId",
                  "generation",
                  "artifactDigest",
                  "at",
                  "criteriaDigest"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "artifactDigest": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "assignmentId": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  },
                  "at": {
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                    "type": "string"
                  },
                  "criterionCount": {
                    "maximum": 1024,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  "generation": {
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "id": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  },
                  "kind": {
                    "const": "acceptances",
                    "type": "string"
                  },
                  "ticketId": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "ticketId",
                  "assignmentId",
                  "generation",
                  "artifactDigest",
                  "at",
                  "criterionCount"
                ],
                "type": "object"
              }
            ]
          },
          "maxItems": 20,
          "type": "array"
        },
        "hasMore": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "contracts",
            "verifications",
            "acceptances"
          ],
          "type": "string"
        },
        "limit": {
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "maxBytes": {
          "const": 131072,
          "type": "number"
        },
        "mode": {
          "const": "live_keyset",
          "type": "string"
        },
        "nextCursor": {
          "maxLength": 8192,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "observedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        },
        "projectId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "protocol": {
          "const": "work-completion-history/1",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "entry_too_large",
                "page_budget"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "returned": {
          "maximum": 20,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "status": {
          "enum": [
            "ok",
            "blocked"
          ],
          "type": "string"
        },
        "workId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "workId",
        "projectId",
        "currentContract",
        "kind",
        "observedAt",
        "mode",
        "authorization",
        "status",
        "reason",
        "limit",
        "returned",
        "available",
        "entries",
        "hasMore",
        "coverage",
        "maxBytes"
      ],
      "type": "object"
    },
    "WorkCompletionHistoryQuery": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "maxLength": 8192,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "contracts",
            "verifications",
            "acceptances"
          ],
          "type": "string"
        },
        "limit": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    }
  },
  "$id": "urn:personal-agent:completion-history:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
