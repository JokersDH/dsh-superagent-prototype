        },
        "requestDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "requestId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "sourceMessageId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "textDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "requestId",
        "requestDigest",
        "sourceMessageId",
        "replyMessageId",
        "projectId",
        "conversationId",
        "principal",
        "model",
        "artifactRef",
        "artifactDigest",
        "textDigest",
        "recordedAt"
      ],
      "type": "object"
