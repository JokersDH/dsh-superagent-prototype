    "CoordinatorChannelLimits": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "maxPayloadBytes": {
          "maximum": 8388608,
          "minimum": 1,
          "type": "integer"
        },
        "maxPendingBytes": {
          "maximum": 16777216,
          "minimum": 1,
          "type": "integer"
        },
        "maxPendingFacts": {
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "maxPendingPayloads": {
          "maximum": 128,
          "minimum": 1,
          "type": "integer"
        },
        "maxPendingWrites": {
          "maximum": 128,
          "minimum": 1,
          "type": "integer"
        },
        "maxSettledRequests": {
          "maximum": 65536,
          "minimum": 1,
          "type": "integer"
        },
        "requestTimeoutMs": {
          "maximum": 300000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "maxPendingFacts",
        "maxPendingPayloads",
        "maxPendingWrites",
        "maxPendingBytes",
        "maxPayloadBytes",
        "requestTimeoutMs",
        "maxSettledRequests"
      ],
      "type": "object"
