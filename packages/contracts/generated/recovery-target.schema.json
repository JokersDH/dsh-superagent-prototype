{
  "$defs": {
    "RecoveryTargetConfiguration": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "executor": {
          "additionalProperties": false,
          "properties": {
            "identityDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "profileId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "revision": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "profileId",
            "revision",
            "identityDigest"
          ],
          "type": "object"
        },
        "projects": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "registration": {
                "additionalProperties": false,
                "properties": {
                  "check": {
                    "enum": [
                      "node_test",
                      "pnpm_test",
                      "npm_test"
                    ],
                    "type": "string"
                  },
                  "displayName": {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string"
                  },
                  "environment": {
                    "oneOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "policy": {
                            "const": "existing_only",
                            "type": "string"
                          }
                        },
                        "required": [
                          "policy"
                        ],
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "policy": {
                            "const": "offline_install",
                            "type": "string"
                          },
                          "storeDir": {
                            "maxLength": 4096,
                            "minLength": 1,
                            "type": "string"
                          }
                        },
                        "required": [
                          "policy",
                          "storeDir"
                        ],
                        "type": "object"
                      }
                    ]
                  },
                  "path": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "check"
                ],
                "type": "object"
              },
              "sourceProjectId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string"
              },
              "targetProjectId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string"
              }
            },
            "required": [
              "sourceProjectId",
              "targetProjectId",
              "registration"
            ],
            "type": "object"
          },
          "maxItems": 20,
          "minItems": 1,
          "readOnly": true,
          "type": "array"
        },
        "protocol": {
          "const": "recovery-target-configuration/1",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "projects",
        "executor"
      ],
      "type": "object"
    },
    "RecoveryTargetInventory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "bounded",
            "unsupported"
          ],
          "type": "string"
        },
        "databaseDigest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrity": {
          "enum": [
            "ok",
            "failed",
            "unknown"
          ],
          "type": "string"
        },
        "issues": {
          "items": {
            "enum": [
              "not_private",
              "unsafe_link",
              "busy_or_changed",
              "unsupported_schema",
              "unknown_table",
              "business_rows_present",
              "missing_database",
              "integrity_failed"
            ],
            "type": "string"
          },
          "maxItems": 16,
          "readOnly": true,
          "type": "array"
        },
        "observedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        },
        "productSchema": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol": {
          "const": "recovery-target-inventory/1",
          "type": "string"
        },
        "startupAvailable": {
          "const": false,
          "type": "boolean"
        },
        "stateRoot": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "tables": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "category": {
                "enum": [
                  "metadata",
                  "business",
                  "unknown"
                ],
                "type": "string"
              },
              "name": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
                "type": "string"
              },
              "rows": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "category",
              "rows"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "readOnly": true,
          "type": "array"
        }
      },
      "required": [
        "protocol",
        "stateRoot",
        "observedAt",
        "productSchema",
        "databaseDigest",
        "integrity",
        "completeness",
        "tables",
        "issues",
        "startupAvailable"
      ],
      "type": "object"
    },
    "RecoveryTargetMaterial": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "activationId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "configurationDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "generationId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "intentDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "manifestDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "preparedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        },
        "productSchema": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "protocol": {
          "const": "recovery-target-material/1",
          "type": "string"
        },
        "startupAvailable": {
          "const": false,
          "type": "boolean"
        },
        "stateRoot": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "activationId",
        "generationId",
        "stateRoot",
        "intentDigest",
        "configurationDigest",
        "manifestDigest",
        "productSchema",
        "preparedAt",
        "startupAvailable"
      ],
      "type": "object"
    },
    "RecoveryTargetPreparation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "additionalProperties": false,
          "properties": {
            "executor": {
              "additionalProperties": false,
              "properties": {
                "identityDigest": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "profileId": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "revision": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "profileId",
                "revision",
                "identityDigest"
              ],
              "type": "object"
            },
            "projects": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "registration": {
                    "additionalProperties": false,
                    "properties": {
                      "check": {
                        "enum": [
                          "node_test",
                          "pnpm_test",
                          "npm_test"
                        ],
                        "type": "string"
                      },
                      "displayName": {
                        "maxLength": 160,
                        "minLength": 1,
                        "type": "string"
                      },
                      "environment": {
                        "oneOf": [
                          {
                            "additionalProperties": false,
                            "properties": {
                              "policy": {
                                "const": "existing_only",
                                "type": "string"
                              }
                            },
                            "required": [
                              "policy"
                            ],
                            "type": "object"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "policy": {
                                "const": "offline_install",
                                "type": "string"
                              },
                              "storeDir": {
                                "maxLength": 4096,
                                "minLength": 1,
                                "type": "string"
                              }
                            },
                            "required": [
                              "policy",
                              "storeDir"
                            ],
                            "type": "object"
                          }
                        ]
                      },
                      "path": {
                        "maxLength": 4096,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "path",
                      "check"
                    ],
                    "type": "object"
                  },
                  "sourceProjectId": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  },
                  "targetProjectId": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  }
                },
                "required": [
                  "sourceProjectId",
                  "targetProjectId",
                  "registration"
                ],
                "type": "object"
              },
              "maxItems": 20,
              "minItems": 1,
              "readOnly": true,
              "type": "array"
            },
            "protocol": {
              "const": "recovery-target-configuration/1",
              "type": "string"
            }
          },
          "required": [
            "protocol",
            "projects",
            "executor"
          ],
          "type": "object"
        },
        "protocol": {
          "const": "recovery-target-preparation/1",
          "type": "string"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "intent": {
              "additionalProperties": false,
              "properties": {
                "activationId": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "commandId": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "createdAt": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                  "type": "string"
                },
                "expiresAt": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                  "type": "string"
                },
                "machineDigest": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "planDigest": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "planId": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "principal": {
                  "additionalProperties": false,
                  "properties": {
                    "authorityRef": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    "userId": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "userId",
                    "authorityRef"
                  ],
                  "type": "object"
                },
                "protocol": {
                  "const": "recovery-activation-intent/1",
                  "type": "string"
                },
                "resourcePolicyDigest": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "source": {
                  "additionalProperties": false,
                  "properties": {
                    "inspectionFingerprint": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "markerDigest": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "stateId": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    "stateRoot": {
                      "maxLength": 4096,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "stateId",
                    "stateRoot",
                    "markerDigest",
                    "inspectionFingerprint"
                  ],
                  "type": "object"
                },
                "target": {
                  "additionalProperties": false,
                  "properties": {
                    "configurationDigest": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "generationId": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    "stateRoot": {
                      "maxLength": 4096,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "generationId",
                    "stateRoot",
                    "configurationDigest"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "protocol",
                "activationId",
                "commandId",
                "planId",
                "planDigest",
                "source",
                "target",
                "principal",
                "machineDigest",
                "resourcePolicyDigest",
                "createdAt",
                "expiresAt"
              ],
              "type": "object"
            },
            "protocol": {
              "const": "recovery-activation-commit/1",
              "type": "string"
            },
            "sourceReceipt": {
              "additionalProperties": false,
              "properties": {
                "commandId": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "seq": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "commandId",
                "seq"
              ],
              "type": "object"
            }
          },
          "required": [
            "protocol",
            "intent",
            "sourceReceipt"
          ],
          "type": "object"
        },
        "startupAvailable": {
          "const": false,
          "type": "boolean"
        }
      },
      "required": [
        "protocol",
        "source",
        "configuration",
        "startupAvailable"
      ],
      "type": "object"
    }
  },
  "$id": "urn:personal-agent:recovery-target:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
