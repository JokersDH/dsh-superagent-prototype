{
  "$defs": {
    "ReviewActivity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "additionalProperties": false,
          "properties": {
            "assignmentId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "candidateGeneration": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "contract": {
              "additionalProperties": false,
              "properties": {
                "digest": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "revision": {
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer"
                },
                "workId": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                }
              },
              "required": [
                "workId",
                "revision",
                "digest"
              ],
              "type": "object"
            },
            "ticketId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "ticketId",
            "assignmentId",
            "contract",
            "candidateGeneration"
          ],
          "type": "object"
        },
        "commandId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "endedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        },
        "protocol": {
          "const": "review-activity/1",
          "type": "string"
        },
        "sessionId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "source": {
          "const": "ui_visibility_proxy",
          "type": "string"
        },
        "startedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "commandId",
        "sessionId",
        "candidate",
        "startedAt",
        "endedAt",
        "source"
      ],
      "type": "object"
    },
    "ReviewTiming": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "acceptedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeReviewCompleteness": {
          "enum": [
            "partial",
            "unknown"
          ],
          "type": "string"
        },
        "activeReviewMs": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeReviewSource": {
          "enum": [
            "ui_visibility_proxy",
            "unknown"
          ],
          "type": "string"
        },
        "candidateReadyAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceRefs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 128,
          "readOnly": true,
          "type": "array"
        },
        "readyToAcceptanceMs": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "candidateReadyAt",
        "acceptedAt",
        "readyToAcceptanceMs",
        "activeReviewMs",
        "activeReviewSource",
        "activeReviewCompleteness",
        "evidenceRefs"
      ],
      "type": "object"
    }
  },
  "$id": "urn:personal-agent:review-timing:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
