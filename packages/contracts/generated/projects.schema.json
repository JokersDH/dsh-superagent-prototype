{
  "$defs": {
    "ProjectRegistrationInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "node_test",
            "pnpm_test",
            "npm_test"
          ],
          "type": "string"
        },
        "displayName": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "environment": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "policy": {
                  "const": "existing_only",
                  "type": "string"
                }
              },
              "required": [
                "policy"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "policy": {
                  "const": "offline_install",
                  "type": "string"
                },
                "storeDir": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "policy",
                "storeDir"
              ],
              "type": "object"
            }
          ]
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "check"
      ],
      "type": "object"
    },
    "WorkEnvironment": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z_]{1,100}$",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "policy": {
          "enum": [
            "existing_only",
            "offline_install"
          ],
          "type": "string"
        },
        "protocol": {
          "const": "work-environment/1",
          "type": "string"
        },
        "status": {
          "enum": [
            "not_configured",
            "waiting",
            "preparing",
            "ready",
            "blocked"
          ],
          "type": "string"
        },
        "workId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "workId",
        "status"
      ],
      "type": "object"
    },
    "WorkLocation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "baseCommit": {
          "anyOf": [
            {
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectPath": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "workspacePath": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "projectPath",
        "workspacePath",
        "baseCommit"
      ],
      "type": "object"
    }
  },
  "$id": "urn:personal-agent:project-configuration:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
