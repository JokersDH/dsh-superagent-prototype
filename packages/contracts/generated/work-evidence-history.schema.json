{
  "$defs": {
    "WorkEvidenceHistory": {
      "$defs": {
        "__schema0": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "items": {
                "$ref": "#/$defs/__schema0"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              },
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "revision": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "workId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "workId",
            "revision",
            "digest"
          ],
          "type": "object"
        },
        "entries": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "at": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                "type": "string"
              },
              "detail": {
                "$ref": "#/$defs/__schema0"
              },
              "kind": {
                "maxLength": 160,
                "minLength": 1,
                "type": "string"
              },
              "sourceRef": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "at",
              "kind",
              "sourceRef",
              "detail"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "readOnly": true,
          "type": "array"
        },
        "hasMore": {
          "type": "boolean"
        },
        "nextCursor": {
          "maxLength": 8192,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "observedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        },
        "protocol": {
          "const": "work-evidence-history/1",
          "type": "string"
        },
        "sourcesCapped": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "readOnly": true,
          "type": "array"
        },
        "window": {
          "enum": [
            "complete",
            "caller_limit",
            "storage_cap"
          ],
          "type": "string"
        },
        "workId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "workId",
        "contract",
        "observedAt",
        "entries",
        "hasMore",
        "window",
        "sourcesCapped"
      ],
      "type": "object"
    },
    "WorkEvidenceHistoryQuery": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "maxLength": 8192,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$id": "urn:personal-agent:work-evidence-history:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
