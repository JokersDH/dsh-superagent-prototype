{
  "name": "@personal-agent/usage-insights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Pure, read-only efficiency observations over existing ExecutionOutcome/ReviewTiming/AttentionPage/WorkEvidence records. No SQL writer, ledger, scheduler, model call or execution authority.",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.case.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@personal-agent/contracts": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "6.0.3"
  }
}
