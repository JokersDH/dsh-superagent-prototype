{
  "name": "@personal-agent/workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Wave-03 A workflow ports: durable conversation catalog/search/archive, versioned project settings, explicit UserDecision persistence, a bounded read index, and consistent database+artifact snapshots. Storage remains the single SQL writer and migration owner.",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.case.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@personal-agent/contracts": "workspace:*",
    "@personal-agent/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "24.10.0",
    "typescript": "6.0.3",
    "better-sqlite3": "13.0.3"
  }
}
