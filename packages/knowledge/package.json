{
  "name": "@personal-agent/knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Explicit user-decision governance over the shared UserDecision/KnowledgePage contracts: source-bound record, revoke, supersede, expiry and queryable effective knowledge. Production persistence is consumed through a public store port owned by storage.",
  "engines": { "node": ">=24.21.0 <25" },
  "packageManager": "pnpm@11.7.0",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.case.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@personal-agent/contracts": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@personal-agent/context": "workspace:*",
    "@personal-agent/proposals": "workspace:*",
    "@types/node": "24.10.0",
    "typescript": "6.0.3"
  }
}
