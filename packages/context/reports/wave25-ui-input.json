{
  "protocol": "restored-scope-ui-input/3",
  "publishedConsumers": {
    "main": { "sourceCommit": "4b42a9001c4040aa6c87c1c6056056d04ea1e9af", "role": "source diagnostic panel and help already implemented" },
    "F": { "path": "apps/console/src/trial/", "role": "new trial experience subtree displays the same backend states; C only supplies data and does not edit console" }
  },
  "backendInput": {
    "endpoint": "GET /v1/messages/:id/context/sources",
    "optIn": "append exactly ?scopeReview=1 on explicit user action",
    "defaultResponse": "unchanged shape without scopeReview",
    "forbiddenInputs": ["principal", "scope/grant", "project override", "authorization claim"],
    "notes": ["presentation only", "authorization is always none", "ignore observedAt when comparing"]
  },
  "states": {
    "verified": "已核对冻结原文；以下内容与当时发送时一致。",
    "scope_changed": "当前只读选择与冻结时不同；冻结原文未展示，历史记录/工作/回答仍可查看。",
    "missing": "冻结原文文件缺失；不会用当前来源替代。",
    "unverified": "无法核对冻结原文；未核对内容不会展示。"
  },
  "reasons": {
    "project_changed": "所属项目与冻结时不同",
    "selection_narrowed": "当前允许路径比冻结时更窄",
    "selection_broadened": "当前允许路径比冻结时更宽",
    "selection_replaced": "允许路径已变化",
    "exclusion_added": "新增了排除路径",
    "exclusion_removed": "移除了排除路径",
    "selection_validity_changed": "选择有效期与冻结时不同"
  },
  "actualSamples": {
    "verifiedValidity": { "state": "verified", "reasons": ["selection_validity_changed"], "partial": false, "withheldSourceCount": 0, "authorization": "none" },
    "scopeChangedNarrow": { "state": "scope_changed", "reasons": ["selection_narrowed", "selection_validity_changed"], "partial": true, "withheldSourceCount": 2, "authorization": "none" },
    "missing": { "state": "missing", "reasons": ["selection_validity_changed"], "partial": true, "withheldSourceCount": 0, "authorization": "none" },
    "unverified": { "state": "unverified", "reasons": [], "partial": true, "withheldSourceCount": 0, "authorization": "none" }
  },
  "packageSample": {
    "consumer": "exact 0ede stage via personal-review-driver/2",
    "verified": { "state": "verified", "diagnostic": { "protocol": "context-scope-review/1", "reasons": [], "partial": false, "withheldSourceCount": 0, "authorization": "none" } },
    "narrow": { "state": "scope_changed", "reasonsIncludes": ["selection_narrowed"], "partial": true, "withheldSourceCountGreaterThan": 0 }
  },
  "sampleProvenance": {
    "sourceSamples": "packages/knowledge/test/main-personal-scope-review.case.ts and main-personal-driver-strict.case.ts",
    "packageSamples": "packages/knowledge/test/main-personal-package-install.case.ts (0ede tar, manifest-driven, two restored roots)"
  },
  "render": {
    "withheldSourceCount": "另有 N 条冻结来源未展示；N 最大 64",
    "partialBadge": "仅 partial 为 true 时显示只读提示",
    "authorization": "不渲染为权限/允许执行/重试许可"
  },
  "doNotRender": ["readable counts", "raw allowed/excluded paths", "principal/tokens/keys", "authorization none as approval"]
}
