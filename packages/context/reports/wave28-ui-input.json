{
  "protocol": "restored-scope-ui-input/6",
  "consumers": {
    "main": { "sourceCommit": "ea82d8f", "role": "source diagnostic UI, FTrialWorkspace, usage observation composition" },
    "F": { "path": "apps/console/src/trial/", "role": "trial UX consumes data; C does not edit it" }
  },
  "backend": {
    "sources": "GET /v1/messages/:id/context/sources?scopeReview=1",
    "readiness": "GET /v1/readiness (authenticated)",
    "targetProof": "driver output data.targetProof via explicit A restore/content verification"
  },
  "states": { "verified": "已核对冻结原文", "scope_changed": "当前只读选择与冻结时不同；原文未展示", "missing": "冻结原文文件缺失", "unverified": "无法核对冻结原文" },
  "reasons": {
    "project_changed": "所属项目与冻结时不同", "selection_narrowed": "当前允许路径比冻结时更窄",
    "selection_broadened": "当前允许路径比冻结时更宽", "selection_replaced": "允许路径已变化",
    "exclusion_added": "新增了排除路径", "exclusion_removed": "移除了排除路径",
    "selection_validity_changed": "选择有效期与冻结时不同"
  },
  "samples": {
    "verifiedValidity": { "state": "verified", "reasons": ["selection_validity_changed"], "partial": false, "withheldSourceCount": 0, "authorization": "none" },
    "scopeChangedNarrow": { "state": "scope_changed", "reasons": ["selection_narrowed", "selection_validity_changed"], "partial": true, "withheldSourceCount": 2, "authorization": "none" },
    "missing": { "state": "missing", "partial": true, "withheldSourceCount": 0, "authorization": "none" },
    "unverified": { "state": "unverified", "partial": true, "withheldSourceCount": 0, "authorization": "none" }
  },
  "readinessSample": {
    "package": "1cdab25 / ecffaa6d", "authorization": "none", "startupMode": "recovery_readonly",
    "development": "readonly", "execution": "unavailable", "discussion": "unknown",
    "projects": { "dispatchable": 0 }, "profiles": { "admittedNative": 0, "admittedControlled": 0 },
    "capabilities": { "decisions": false, "proposals": false }
  },
  "proofBoundary": {
    "allowed": ["subject.dataRoot"], "rejected": ["work.accepted event", "legal message", "artifact bytes", "wrong snapshot/content"],
    "notAuthority": ["content proof", "readiness authorization none", "driver verified-flow"]
  },
  "forbidden": ["readable counts", "raw paths", "principal/tokens", "authorization none as approval", "proof as native/execution readiness"]
}
